    timestamp read_at
    timestamp created_at
  }

  NOTIFICATIONS {
    uuid id PK
    uuid tenant_id FK
    uuid user_id FK
    varchar type
    varchar title
    text message
    timestamp read_at
    timestamp created_at
  }

  PATIENT_CONTACT_METHODS {
    uuid id PK
    uuid tenant_id FK
    uuid patient_id FK
    varchar type
    varchar value
    boolean is_primary
    varchar consent_status
    timestamp created_at
    timestamp updated_at
  }

  EXTERNAL_NOTIFICATIONS {
    uuid id PK
    uuid tenant_id FK
    uuid patient_id FK
