    uuid id PK
    uuid tenant_id FK
    uuid patient_id FK
    uuid collaborator_id FK
    uuid clinic_id FK
    uuid room_id FK
    uuid appointment_type_id FK
    timestamp starts_at
    timestamp ends_at
    integer pre_session_minutes
    integer post_session_minutes
    varchar status
    uuid created_by_user_id FK
    uuid updated_by_user_id FK
    timestamp created_at
    timestamp updated_at
  }

  ATTENDANCE_RECORDS {
    uuid id PK
    uuid tenant_id FK
    uuid appointment_id FK
    uuid patient_id FK
    uuid collaborator_id FK
    uuid checked_by_user_id FK
