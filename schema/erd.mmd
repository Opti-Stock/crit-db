  TENANTS {
    uuid id PK
    varchar code UK
    varchar name
    varchar state
    varchar city
    varchar status
    timestamp created_at
    timestamp updated_at
  }

  USERS {
    uuid id PK
    uuid tenant_id FK
    varchar full_name
    varchar email
    varchar password_hash
    varchar status
    timestamp last_login_at
    timestamp created_at
    timestamp updated_at
  }

  ROLES {
    uuid id PK
    uuid tenant_id FK
    varchar name
    text description
    timestamp created_at
    timestamp updated_at
  }

  USER_ROLES {
    uuid id PK
    uuid tenant_id FK
    uuid user_id FK
    uuid role_id FK
    timestamp created_at
  }

  USER_CLINIC_ACCESS {
    uuid id PK
    uuid tenant_id FK
    uuid user_id FK
    uuid clinic_id FK
    varchar access_level
    timestamp created_at
  }

  PATIENTS {
    uuid id PK
    uuid tenant_id FK
    uuid user_id FK
    varchar external_id
    varchar full_name
    date birth_date
    varchar phone
    varchar email
    varchar disability
    varchar gender
    varchar status
    timestamp created_at
    timestamp updated_at
  }

  COLLABORATORS {
    uuid id PK
    uuid tenant_id FK
    uuid user_id FK
    varchar external_id
