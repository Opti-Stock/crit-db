    varchar recipient
    varchar status
    varchar provider
    varchar provider_message_id
    timestamp sent_at
    timestamp created_at
  }

  CRIT_API_OUTBOX {
    uuid id PK
    uuid tenant_id FK
    varchar entity_type
    uuid entity_id
    jsonb payload
    varchar status
    integer retry_count
    text last_error
    timestamp sent_at
    timestamp created_at
    timestamp updated_at
  }

  AUDIT_LOGS {
    uuid id PK
    uuid tenant_id FK
    uuid user_id FK
    varchar action
    varchar entity_type
    uuid entity_id
    jsonb metadata
    timestamp created_at
  }
